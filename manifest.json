{
  "manifest_version": 3,
  "name": "Latex",
  "version": "1.0.1",
  "description": "Latin/Latex (Changed-style) encoder for Discord web",
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["src/core.js", "src/composer.js", "src/messages.js"],
      "run_at": "document_idle"
    }
  ]
}
